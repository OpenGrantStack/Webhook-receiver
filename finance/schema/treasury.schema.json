{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Treasury",
  "type": "object",
  "required": ["id", "name", "organizationId", "currency"],
  "properties": {
    "id": { "type": "string", "pattern": "^try_[a-z0-9]{14}$" },
    "name": { "type": "string" },
    "organizationId": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "wallets": { "type": "array", "items": { "type": "string" } },
    "balance": {
      "type": "object",
      "properties": {
        "committed": { "type": "number", "description": "Funds promised to approved applications" },
        "escrowed": { "type": "number", "description": "Funds held in escrow" },
        "disbursed": { "type": "number", "description": "Funds released" },
        "available": { "type": "number", "description": "Uncommitted funds" }
      }
    },
    "quorum": {
      "type": "object",
      "required": ["m", "n"],
      "properties": {
        "m": { "type": "number" },
        "n": { "type": "number" },
        "signers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spendingLimits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "threshold": { "type": "number" },
          "quorumM": { "type": "number" },
          "quorumN": { "type": "number" },
          "requiresRoles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "approvalPolicy": {
      "type": "string",
      "enum": ["maker-approver", "m-of-n", "unanimous", "role-based"]
    },
    "status": { "type": "string", "enum": ["active", "frozen", "closed"], "default": "active" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}