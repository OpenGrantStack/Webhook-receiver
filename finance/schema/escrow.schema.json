{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Escrow",
  "type": "object",
  "required": ["id", "applicationId", "amount", "currency", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^esc_[a-z0-9]{14}$" },
    "applicationId": { "type": "string" },
    "walletId": { "type": "string" },
    "amount": { "type": "number" },
    "currency": { "type": "string" },
    "releasedAmount": { "type": "number", "default": 0 },
    "refundedAmount": { "type": "number", "default": 0 },
    "status": { "type": "string", "enum": ["CREATED", "FUNDED", "PARTIALLY_RELEASED", "RELEASED", "REFUNDED", "CANCELLED", "DISPUTED"] },
    "milestoneIds": { "type": "array", "items": { "type": "string" } },
    "fundedAt": { "type": "string", "format": "date-time" },
    "releasedAt": { "type": "string", "format": "date-time" },
    "depositTransactionId": { "type": "string" },
    "releaseTransactionIds": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}