{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebhookPayload",
  "type": "object",
  "required": ["id", "source", "event", "receivedAt", "signatureValid", "body"],
  "properties": {
    "id": { "type": "string", "pattern": "^pld_[a-z0-9]{14}$" },
    "source": { "type": "string", "enum": ["stripe", "paypal", "coinbase", "circle", "request-network", "safe", "stellar", "custom"] },
    "event": { "type": "string" },
    "eventId": { "type": "string", "description": "Provider's unique event ID for idempotency" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "signatureValid": { "type": "boolean" },
    "signatureAlgorithm": { "type": "string", "default": "HMAC-SHA256" },
    "rawBody": { "type": "string", "description": "Raw request body for signature verification" },
    "body": { "type": "object" },
    "processed": { "type": "boolean", "default": false },
    "processedAt": { "type": "string", "format": "date-time" },
    "processingError": { "type": "string" },
    "retryCount": { "type": "number", "default": 0 },
    "transactionId": { "type": "string" }
  }
}